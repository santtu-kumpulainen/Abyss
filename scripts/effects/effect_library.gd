class_name EffectLibrary
extends RefCounted
## Central catalog of shared visual effects (Issue #49): effect id -> EffectSheet.
## Gameplay code spawns by id (EffectLibrary.spawn(&"heal", ...)) instead of
## loading sheets or asset paths itself; every effect plays through PixelEffect.
## The Super Pixel Effects Gigapack sheets in scenes/effects/gigapack/ are
## generated by tools/build_gigapack_effects.gd (sources, credits and future
## candidates: assets/effects/README.md).

const SHEETS := {
	## Dash start puff (rotate it against the dash direction).
	&"dash_puff": preload("res://scenes/effects/gigapack/dash_puff.tres"),
	## Home Teleport cast: ground ring (looping single frame, scaled with the cast progress).
	&"teleport_ring": preload("res://scenes/effects/gigapack/teleport_ring.tres"),
	## Home Teleport cast: aura around the Mage (looping).
	&"teleport_aura": preload("res://scenes/effects/gigapack/teleport_aura.tres"),
	## Home Teleport arrival beam.
	&"teleport_arrive": preload("res://scenes/effects/gigapack/teleport_arrive.tres"),
	## Health Potion drunk.
	&"heal": preload("res://scenes/effects/gigapack/heal.tres"),
	## Speed Potion drunk.
	&"haste": preload("res://scenes/effects/gigapack/haste.tres"),
	## Anvil supply bought.
	&"coin_burst": preload("res://scenes/effects/gigapack/coin_burst.tres"),
}


static func has(id: StringName) -> bool:
	return SHEETS.has(id)


## The EffectSheet registered as `id`, or null (with an error) if unknown.
static func sheet(id: StringName) -> EffectSheet:
	if not SHEETS.has(id):
		push_error("EffectLibrary: unknown effect %s" % id)
		return null
	return SHEETS[id]


## Spawns effect `id` under `parent` at `global_pos` (see PixelEffect.spawn();
## `rotation` in radians). Returns null for unknown ids or without a parent.
static func spawn(id: StringName, parent: Node, global_pos: Vector2, rotation: float = 0.0,
		duration: float = 0.0, diameter: float = 0.0) -> PixelEffect:
	var effect := PixelEffect.spawn(sheet(id), parent, global_pos, duration, diameter)
	if effect:
		effect.rotation = rotation
	return effect
