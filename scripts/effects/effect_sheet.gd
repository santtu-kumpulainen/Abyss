class_name EffectSheet
extends Resource
## Sprite-sheet effect: a grid of `frame_size` cells (Free Pixel Effects Pack:
## 100x100; Super Pixel Effects Gigapack: per sheet, generated by
## tools/build_gigapack_effects.gd). Play it with PixelEffect.spawn() or
## EffectLibrary.spawn(). `first_frame`/`frame_count` select the filled cells of
## the sheet (some sheets start with an empty cell). One-shot by default;
## `loop` sheets repeat until PixelEffect.stop().

@export var texture: Texture2D
## Frames per row (sheet width / frame_size.x).
@export var columns: int = 1
## Index of the first filled cell and the number of frames to play.
@export var first_frame: int = 0
@export var frame_count: int = 1
@export var fps: float = 60.0
## Sprite scale (relative to one source cell).
@export var scale: float = 0.5
@export var tint: Color = Color.WHITE
## Size of one cell in the sheet, in pixels.
@export var frame_size := Vector2i(100, 100)
## Repeat the frames until PixelEffect.stop() instead of freeing after one pass.
@export var loop := false


## Texture region of cell `index` (row by row from the top-left, `columns` per row).
func frame_rect(index: int) -> Rect2:
	var cols := maxi(columns, 1)
	return Rect2(Vector2(index % cols, floori(index / float(cols))) * Vector2(frame_size), Vector2(frame_size))
